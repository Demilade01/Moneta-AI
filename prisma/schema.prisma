// Moneta AI - Intelligent Pricing Analyst Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  role          UserRole @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  products        Product[]
  simulations     Simulation[]
  recommendations Recommendation[]
  dataUploads     DataUpload[]

  @@index([email])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

// ============================================
// PRODUCT & PRICING
// ============================================

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  category    String?

  // Current Pricing
  currentPrice Decimal  @db.Decimal(10, 2)
  costPrice    Decimal  @db.Decimal(10, 2)
  currency     String   @default("USD")

  // Metadata
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Ownership
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  priceHistory      PriceHistory[]
  salesData         SalesData[]
  competitorData    CompetitorData[]
  simulationItems   SimulationItem[]
  recommendations   Recommendation[]

  @@index([userId])
  @@index([sku])
  @@index([category])
  @@map("products")
}

model PriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  price       Decimal  @db.Decimal(10, 2)
  costPrice   Decimal? @db.Decimal(10, 2)

  // Change metadata
  changeReason String?
  changedBy    String?

  effectiveDate DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([effectiveDate])
  @@map("price_history")
}

// ============================================
// SALES & PERFORMANCE DATA
// ============================================

model SalesData {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Sales metrics
  unitsSold   Int
  revenue     Decimal  @db.Decimal(12, 2)
  cost        Decimal? @db.Decimal(12, 2)
  margin      Decimal? @db.Decimal(5, 2) // Percentage

  // Time period
  periodStart DateTime
  periodEnd   DateTime
  periodType  PeriodType @default(DAILY)

  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([periodStart, periodEnd])
  @@map("sales_data")
}

enum PeriodType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// ============================================
// COMPETITOR & MARKET DATA
// ============================================

model CompetitorData {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  competitorName String
  competitorPrice Decimal @db.Decimal(10, 2)
  productUrl     String?

  // Market signals
  availability   String?  // In stock, Out of stock, Low stock
  rating         Decimal? @db.Decimal(3, 2)
  reviewCount    Int?

  scrapedAt      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([productId])
  @@index([scrapedAt])
  @@map("competitor_data")
}

// ============================================
// SIMULATIONS (What-If Scenarios)
// ============================================

model Simulation {
  id          String   @id @default(cuid())
  name        String
  description String?

  // Simulation config
  duration    Int      // Days
  startDate   DateTime
  endDate     DateTime

  // Status
  status      SimulationStatus @default(DRAFT)

  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  items       SimulationItem[]
  results     SimulationResult[]

  @@index([userId])
  @@index([status])
  @@map("simulations")
}

enum SimulationStatus {
  DRAFT
  RUNNING
  COMPLETED
  FAILED
}

model SimulationItem {
  id            String     @id @default(cuid())
  simulationId  String
  simulation    Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  productId     String
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Price change
  currentPrice  Decimal    @db.Decimal(10, 2)
  proposedPrice Decimal    @db.Decimal(10, 2)
  changePercent Decimal    @db.Decimal(5, 2)

  createdAt     DateTime   @default(now())

  @@index([simulationId])
  @@index([productId])
  @@map("simulation_items")
}

model SimulationResult {
  id           String     @id @default(cuid())
  simulationId String
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  // Projected outcomes
  projectedRevenue Decimal  @db.Decimal(12, 2)
  projectedUnits   Int
  projectedMargin  Decimal  @db.Decimal(12, 2)

  // vs Current
  revenueDelta     Decimal  @db.Decimal(12, 2)
  unitsDelta       Int
  marginDelta      Decimal  @db.Decimal(12, 2)

  // Confidence & Risk
  confidence       Decimal  @db.Decimal(5, 2) // 0-100%
  riskLevel        RiskLevel

  createdAt        DateTime @default(now())

  @@index([simulationId])
  @@map("simulation_results")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

// ============================================
// AI RECOMMENDATIONS
// ============================================

model Recommendation {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Recommendation details
  currentPrice    Decimal @db.Decimal(10, 2)
  recommendedPrice Decimal @db.Decimal(10, 2)
  changePercent   Decimal @db.Decimal(5, 2)

  // Priority & Status
  priority        Priority @default(MEDIUM)
  status          RecommendationStatus @default(PENDING)

  // AI Reasoning
  reasoning       String   // Full explanation
  confidenceScore Decimal  @db.Decimal(5, 2) // 0-100%

  // Impact projections
  projectedRevenueImpact Decimal? @db.Decimal(12, 2)
  projectedMarginImpact  Decimal? @db.Decimal(12, 2)
  projectedDemandImpact  Decimal? @db.Decimal(5, 2) // Percentage

  // Risk assessment
  riskLevel       RiskLevel
  riskFactors     String?  // JSON array of risk factors

  // Historical comparison
  historicalContext String? // Similar past scenarios

  // Metadata
  generatedAt     DateTime @default(now())
  expiresAt       DateTime? // Recommendations can expire
  implementedAt   DateTime?

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([priority])
  @@map("recommendations")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
  IMPLEMENTED
  EXPIRED
}

// ============================================
// DATA UPLOADS & ANALYTICS
// ============================================

model DataUpload {
  id          String   @id @default(cuid())
  fileName    String
  fileType    String   // CSV, XLSX, JSON
  fileSize    Int      // Bytes

  // Upload status
  status      UploadStatus @default(PROCESSING)
  rowsProcessed Int?
  rowsFailed    Int?
  errorLog      String?  // JSON array of errors

  // Metadata
  uploadedAt  DateTime @default(now())
  processedAt DateTime?

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("data_uploads")
}

enum UploadStatus {
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// ANALYTICS & INSIGHTS
// ============================================

model PricingInsight {
  id          String   @id @default(cuid())

  // Insight details
  title       String
  description String
  category    InsightCategory
  severity    Priority @default(MEDIUM)

  // Data points
  metric      String   // What metric this relates to
  currentValue Decimal? @db.Decimal(12, 2)
  targetValue  Decimal? @db.Decimal(12, 2)

  // Related entities
  affectedProducts String[] // Array of product IDs

  // Metadata
  generatedAt DateTime @default(now())
  isRead      Boolean  @default(false)

  @@index([category])
  @@index([severity])
  @@index([generatedAt])
  @@map("pricing_insights")
}

enum InsightCategory {
  PRICE_ELASTICITY
  COMPETITIVE_POSITIONING
  MARGIN_OPTIMIZATION
  DEMAND_PATTERN
  SEASONAL_TREND
  ANOMALY_DETECTION
}
